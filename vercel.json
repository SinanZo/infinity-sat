{
  "version": 2,
  "buildCommand": "pnpm install && pnpm run build",
  "installCommand": "pnpm install",
  "outputDirectory": "build/client",
  "routes": [
    {
      "src": "/api/trpc/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/oauth/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/build/client/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
      "dest": "/build/client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/build/client/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
